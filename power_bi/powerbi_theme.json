{
  "name": "ExecutiveDarkAnalytics",
  "dataColors": [
    "#6366F1",
    "#38BDF8",
    "#10B981",
    "#F59E0B",
    "#EC4899",
    "#8B5CF6",
    "#14B8A6",
    "#F43F5E",
    "#E2E8F0",
    "#94A3B8"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#6366F1",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 60,
            "shadowBlur": 8
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#38BDF8"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
